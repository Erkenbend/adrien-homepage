# Build settings, documented in docs/build-settings.md.
# Checked when Vite starts (build-plugins/settings.ts): an unknown value fails `bun dev` and `bun run build`.
# Override for one build (`VITE_LAYOUT=split bun run build`) or locally in `.env.local` (not committed).
# In `bun dev`, the options picker on the left overrides them for comparison.

# Arrangement of the page: classic | showcase | sidebar | split | bento
VITE_LAYOUT=classic

# Look of the project graph: classic | matrix | lines | open
VITE_GRAPH=lines

# Address of the deployed page, for the absolute URLs of link previews (Open Graph): https://… without a path.
# Checked when Vite starts (build-plugins/page-meta.ts).
VITE_SITE_URL=https://adrien.wehrung.online
